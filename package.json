{
  "name": "pieradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "sync": "tsx scripts/sync-once.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .data/test && PGLITE_DIR=.data/test tsx scripts/sync-once.mts > /dev/null && PGLITE_DIR=.data/test tsx tests/pipeline.test.mts && PGLITE_DIR=.data/test tsx tests/t212-import.test.mts",
    "demo:purge": "tsx scripts/purge-demo.mts",
    "t212:setup": "tsx scripts/t212-setup.mts",
    "fast": "next build && next start"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.20",
    "@upstash/redis": "^1.39.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.3.0",
    "inngest": "^4.24.0",
    "lucide-react": "^1.57.0",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "license": "MIT",
  "author": "Zainul Abid"
}
