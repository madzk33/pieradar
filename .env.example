# ── Database ───────────────────────────────────────────────────────────────
# Postgres (Neon / Supabase / RDS). Leave empty locally to use embedded PGlite in ./.data
DATABASE_URL=

# ── Cache ──────────────────────────────────────────────────────────────────
# Upstash Redis (Vercel Marketplace → Upstash). Empty = in-process cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Data sources ───────────────────────────────────────────────────────────
# Auto-synced sources, comma separated:
#   demo     = simulated universe (great for development; label "Simulated")
#   t212-api = your own Trading 212 accounts via the official API (label "Verified")
# For a real-data-only site use PIE_SOURCES=t212-api and run `npm run demo:purge` once.
PIE_SOURCES=demo
# "key:secret[:Display name],key2:secret2" — Trading 212 → Settings → API, Pies read permission only
T212_API_ACCOUNTS=
# Or, for a single account (simplest; secrets may contain any characters):
T212_API_KEY=
T212_API_SECRET=
T212_API_NAME=
# Let "Create in Trading 212" use the key above. Personal/local use only:
# on a public site every visitor's click would create pies in YOUR account.
ALLOW_OWNER_CREATE=off
T212_API_ENV=live
# Let visitors import their own public pies with a one-time key (never stored)
ALLOW_USER_IMPORT=on

# demo | yahoo | polygon   (polygon prices US listings, Yahoo covers LSE/EU)
MARKET_PROVIDER=demo
POLYGON_API_KEY=

# ── Background jobs ────────────────────────────────────────────────────────
# Inngest (recommended on Vercel). When INNGEST_SIGNING_KEY is set, /api/cron/* stands down.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Vercel Cron fallback auth (Vercel sends it as a Bearer token automatically)
CRON_SECRET=

# Local in-process scheduler: "off" to disable (e.g. when running `npx inngest-cli dev`)
LOCAL_SCHEDULER=
# Keep re-marking prices outside market hours (demo). Set 0 to only tick during market hours.
DEMO_ALWAYS_LIVE=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Encrypts "connected account" cookies for one-click pie creation (required in production).
# Generate with: openssl rand -hex 32
BROKER_SESSION_SECRET=
